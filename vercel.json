{
  "cleanUrls": true,
  "redirects": [
    { "source": "/login", "destination": "/lms", "permanent": true },
    { "source": "/login.html", "destination": "/lms", "permanent": true }
  ],
  "rewrites": [
    { "source": "/lms/data/:path*", "destination": "/data/:path*" }
  ],
  "headers": [
    {
      "source": "/lms/authorized_roster.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ]
}
